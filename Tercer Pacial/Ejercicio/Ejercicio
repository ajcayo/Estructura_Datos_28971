#include <iostream>

void ejemploIterativo(int n) {
    // 1. El bucle externo es LINEAL: se ejecuta exactamente 'n' veces.
    for (int i = 0; i < n; i++) {
        
        // 2. El bucle interno es LOGARÍTMICO: 'j' se duplica en cada paso.
        // ¿Cuántas veces puede duplicarse 'j' antes de alcanzar o superar 'n'? 
        // Exactamente log2(n) veces.
        for (int j = 1; j < n; j = j * 2) {
            // Operación constante O(1)
            std::cout << "*"; 
        }
    }
    std::cout << std::endl;
}

int main() {
    int n = 8;
    std::cout << "Para n = " << n << ", las operaciones totales seran n * log2(n)" << std::endl;
    std::cout << "Es decir: 8 * 3 = 24 asteriscos impresos:" << std::endl;
    ejemploIterativo(n);
    return 0;
}